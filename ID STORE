# ==============================
# RUN BOT
# ==============================

def main():

    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(
        CommandHandler("start", start)
    )

    app.add_handler(
        CallbackQueryHandler(button_handler)
    )

    print("🤖 BGMI ID STORE BOT STARTED!")

    app.run_polling()


if __name__ == "__main__":
    main()
